{
  "name": "futa-e",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": ">=9.15.0 <10"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "package": "pnpm run package:mac",
    "package:mac": "pnpm run build && pnpm dlx electron-builder@26.8.1 --mac zip --arm64 --config electron-builder.config.cjs --publish never",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tsc": "tsc --noEmit -p tsconfig.json",
    "vue-tsc": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck": "pnpm run tsc && pnpm run vue-tsc",
    "lint": "pnpm run typecheck && pnpm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.2",
    "electron-store": "^11.0.2",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@types/node": "^25.0.5",
    "@vitejs/plugin-vue": "^6.0.3",
    "electron": "^42.0.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.8.1",
    "sass-embedded": "^1.98.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5"
  }
}
